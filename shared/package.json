{
  "name": "@kingsmaker/shared",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc --build && cp -r prisma/generated dist/prisma/",
    "build:bun": "bun build ./index.ts --outdir ./dist --target node",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma"
  },
  "dependencies": {
    "@elysiajs/eden": "^1.3.2",
    "@prisma/client": "^6.9.0",
    "dotenv": "^16.0.0",
    "elysia": "^1.3.4",
    "ioredis": "^5.3.2",
    "unique-names-generator": "^4.7.1",
    "uuid": "^11.1.0",
    "zod": "^4.0.9"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "prisma": "^6.9.0",
    "typescript": "^5.0.0"
  }
}
